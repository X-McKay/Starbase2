ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}
RUN python3 -m venv --without-pip /opt/worker
COPY fixture_worker.py /opt/worker/lib/python3.12/site-packages/fixture_worker.py
COPY server.py /fixture/server.py
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
ENTRYPOINT ["/opt/worker/bin/python3", "-I", "-B", "/fixture/server.py"]

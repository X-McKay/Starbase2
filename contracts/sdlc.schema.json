{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SdlcContract",
  "type": "object",
  "properties": {
    "discovery": {
      "$ref": "#/$defs/DiscoveryInput"
    },
    "effect": {
      "$ref": "#/$defs/SdlcEffect"
    },
    "event": {
      "$ref": "#/$defs/SdlcEvent"
    },
    "feedback": {
      "$ref": "#/$defs/FeedbackInput"
    },
    "input": {
      "$ref": "#/$defs/SdlcInput"
    },
    "mission_summary": {
      "$ref": "#/$defs/SdlcMissionSummary"
    },
    "policy": {
      "$ref": "#/$defs/SdlcPolicy"
    },
    "pr_observation": {
      "$ref": "#/$defs/SdlcPrObservation"
    },
    "publication": {
      "$ref": "#/$defs/SdlcPublication"
    },
    "retry": {
      "$ref": "#/$defs/SdlcRetry"
    },
    "snapshot": {
      "$ref": "#/$defs/SdlcSnapshot"
    },
    "stage_evidence": {
      "$ref": "#/$defs/SdlcStageEvidence"
    },
    "verification": {
      "$ref": "#/$defs/SdlcVerificationInput"
    }
  },
  "required": [
    "feedback",
    "discovery",
    "pr_observation",
    "verification",
    "retry",
    "effect",
    "policy",
    "input",
    "event",
    "publication",
    "snapshot",
    "mission_summary",
    "stage_evidence"
  ],
  "$defs": {
    "DiscoveryInput": {
      "type": "object",
      "properties": {
        "build": true,
        "capability_digest": {
          "type": "string"
        },
        "observed_at": {
          "type": "number",
          "format": "double"
        },
        "opportunity": {
          "type": "string"
        },
        "outcome": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_digest": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "opportunity",
        "build",
        "capability_digest",
        "outcome",
        "reason",
        "observed_at"
      ]
    },
    "FeedbackInput": {
      "type": "object",
      "properties": {
        "captured": true,
        "digest": {
          "type": "string"
        },
        "head": {
          "type": "string"
        },
        "observed_at": {
          "type": "number",
          "format": "double"
        },
        "proposal": true
      },
      "additionalProperties": false,
      "required": [
        "head",
        "digest",
        "captured",
        "proposal",
        "observed_at"
      ]
    },
    "SdlcCaseResults": {
      "type": "object",
      "properties": {
        "failed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "passed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "passed",
        "failed"
      ]
    },
    "SdlcCoordinationSummary": {
      "type": "object",
      "properties": {
        "admission": {
          "type": "string"
        },
        "can_discover": {
          "type": "boolean"
        },
        "reserved_opportunities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "resolution": {
          "type": "string"
        }
      },
      "required": [
        "admission",
        "can_discover",
        "reserved_opportunities",
        "resolution"
      ]
    },
    "SdlcDiffStats": {
      "type": "object",
      "properties": {
        "additions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "deletions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "required": [
        "files",
        "additions",
        "deletions"
      ]
    },
    "SdlcEffect": {
      "type": "object",
      "properties": {
        "data": true,
        "key": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "kind",
        "data"
      ]
    },
    "SdlcEvent": {
      "type": "object",
      "properties": {
        "data": true,
        "key": {
          "type": "string"
        },
        "stage": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "key",
        "stage",
        "data"
      ]
    },
    "SdlcEventSummary": {
      "type": "object",
      "properties": {
        "at": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "key": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "stage",
        "label"
      ]
    },
    "SdlcGradingSummary": {
      "type": "object",
      "properties": {
        "baseline_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "candidate_pass": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "verdict": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SdlcInput": {
      "type": "object",
      "properties": {
        "build": true,
        "capability_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "opportunity": {
          "type": "string"
        },
        "repository": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "repository",
        "revision",
        "opportunity",
        "build"
      ]
    },
    "SdlcInputSummary": {
      "type": "object",
      "properties": {
        "build_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "capability_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "opportunity": {
          "type": [
            "string",
            "null"
          ]
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id"
      ]
    },
    "SdlcMissionSummary": {
      "type": "object",
      "properties": {
        "assigned_crew": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "type": "string"
          }
        },
        "cancel_requested": {
          "type": "boolean"
        },
        "created_at": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "current_stage": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "id": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/SdlcInputSummary"
        },
        "latest_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcEventSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "objective": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_generation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "publication": {
          "$ref": "#/$defs/SdlcPublicationSummary"
        },
        "recent_events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SdlcEventSummary"
          }
        },
        "repository": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision_count": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "stage_evidence": {
          "$ref": "#/$defs/SdlcStageEvidence"
        },
        "state": {
          "type": "string"
        },
        "updated_at": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "verdict": {
          "type": [
            "string",
            "null"
          ]
        },
        "verifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SdlcVerificationSummary"
          }
        }
      },
      "required": [
        "id",
        "state",
        "revision_count",
        "recent_events",
        "event_count",
        "publication",
        "cancel_requested",
        "input",
        "verifications",
        "stage_evidence"
      ]
    },
    "SdlcPage": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "next_before": {
          "type": [
            "string",
            "null"
          ]
        },
        "order": {
          "type": "string"
        },
        "returned": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "required": [
        "order",
        "limit",
        "total",
        "returned"
      ]
    },
    "SdlcPlanEvidence": {
      "type": "object",
      "properties": {
        "decision": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SdlcPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "expires_at": {
          "type": "number",
          "format": "double"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "max_missions": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "publish": {
          "type": "boolean"
        },
        "repository": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "repository",
        "enabled",
        "publish",
        "generation",
        "max_missions",
        "expires_at"
      ]
    },
    "SdlcPrObservation": {
      "type": "object",
      "properties": {
        "head": {
          "type": "string"
        },
        "number": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "observed_at": {
          "type": "number",
          "format": "double"
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "number",
        "head",
        "state",
        "observed_at"
      ]
    },
    "SdlcPublication": {
      "type": "object",
      "properties": {
        "artifact_digest": {
          "type": "string"
        },
        "revision": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "artifact_digest",
        "revision"
      ]
    },
    "SdlcPublicationSummary": {
      "type": "object",
      "properties": {
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_number": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "pr_observed_at": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "pr_state": {
          "type": [
            "string",
            "null"
          ]
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "state": {
          "type": "string"
        }
      },
      "required": [
        "state"
      ]
    },
    "SdlcRetry": {
      "type": "object",
      "properties": {
        "build": true,
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "build"
      ]
    },
    "SdlcReviewEvidence": {
      "type": "object",
      "properties": {
        "findings": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/SdlcReviewFinding"
          }
        },
        "findings_truncated": {
          "type": "boolean"
        },
        "missing_evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "rationale": {
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "findings_truncated"
      ]
    },
    "SdlcReviewFinding": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "problem": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SdlcSnapshot": {
      "type": "object",
      "properties": {
        "capability_catalog": true,
        "coordination": {
          "$ref": "#/$defs/SdlcCoordinationSummary"
        },
        "discovery_count": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "missions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SdlcMissionSummary"
          }
        },
        "page": {
          "$ref": "#/$defs/SdlcPage"
        },
        "policy": {
          "$ref": "#/$defs/SdlcPolicy"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "verification_enabled": {
          "type": "boolean"
        },
        "view": {
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "view",
        "enabled",
        "verification_enabled",
        "policy",
        "coordination",
        "capability_catalog",
        "discovery_count",
        "missions",
        "page"
      ]
    },
    "SdlcStageEvidence": {
      "type": "object",
      "properties": {
        "plan": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcPlanEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewing": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcReviewEvidence"
            },
            {
              "type": "null"
            }
          ]
        },
        "testing": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcTestingEvidence"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "SdlcTestingEvidence": {
      "type": "object",
      "properties": {
        "artifact_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "baseline_cases": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcCaseResults"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_cases": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcCaseResults"
            },
            {
              "type": "null"
            }
          ]
        },
        "diff": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcDiffStats"
            },
            {
              "type": "null"
            }
          ]
        },
        "grading": {
          "anyOf": [
            {
              "$ref": "#/$defs/SdlcGradingSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "validation_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "verdict": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SdlcVerificationInput": {
      "type": "object",
      "properties": {
        "build": true,
        "feedback_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "head",
        "build"
      ]
    },
    "SdlcVerificationInputSummary": {
      "type": "object",
      "properties": {
        "build_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "feedback_digest": {
          "type": [
            "string",
            "null"
          ]
        },
        "head": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "SdlcVerificationSummary": {
      "type": "object",
      "properties": {
        "cancel_requested": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "input": {
          "$ref": "#/$defs/SdlcVerificationInputSummary"
        },
        "outcome": {
          "type": [
            "string",
            "null"
          ]
        },
        "policy_generation": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "state": {
          "type": "string"
        },
        "updated_at": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "required": [
        "id",
        "state",
        "cancel_requested",
        "input"
      ]
    }
  }
}
